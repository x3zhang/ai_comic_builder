# 与 pnpm-workspace.yaml 中 fetchTimeout 等重复时以 workspace 为准（pnpm v11+ 网络项优先写在 workspace）
# 保留此处便于仍读取 .npmrc 的工具链；pnpm 安装大包主要依赖 pnpm-workspace.yaml
fetch-timeout=1800000
fetch-retries=10
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=600000
# 降低并发，减少大 tarball 下到一半被掐断（error 23）
network-concurrency=1
